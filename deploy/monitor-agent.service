[Unit]
Description=Monitor read-only agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=token:/etc/monitor-agent.token
Environment=MONITOR_TOKEN_FILE=%d/token
ExecStart=/usr/local/bin/monitor-agent --server https://monitor.example.com --interval 2 --disk /
Restart=always
RestartSec=5s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/
InaccessiblePaths=-/tmp -/var/tmp -/dev/shm
SystemCallFilter=~@mount
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
